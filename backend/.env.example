# LLM Evaluation Platform — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# You only need ONE of these. The system tries them in order:
#   Gemini (free) → Grok (free) → Claude (paid)

# Google Gemini — get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok — get free key at https://console.x.ai
GROK_API_KEY=

# Anthropic Claude (paid fallback) — https://console.anthropic.com
ANTHROPIC_API_KEY=
